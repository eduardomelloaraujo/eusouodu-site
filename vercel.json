{
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/semana.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/musica/cidades.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/mapa-*.js": {
      "includeFiles": "{lib/fontes/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/musica-*.js": {
      "includeFiles": "{musica/motor.js,musica/catalogo.json,lib/vendor/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "musica.eusouodu.com"
        }
      ],
      "destination": "/musica/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/musica-diario",
      "schedule": "0 9 * * *"
    }
  ]
}