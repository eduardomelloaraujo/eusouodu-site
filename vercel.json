{
  "buildCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/lib/(.*)",
      "status": 307,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/scripts/(.*)",
      "status": 307,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/semana.json",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/musica/cidades.json",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "/jornada/sw.js",
      "headers": {
        "Service-Worker-Allowed": "/",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/jornada/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "musica.eusouodu.com"
        }
      ],
      "dest": "/musica/index.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "jornada.eusouodu.com"
        }
      ],
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/jornada/index.html"
    }
  ],
  "functions": {
    "api/mapa-*.js": {
      "includeFiles": "{lib/fontes/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/musica-*.js": {
      "includeFiles": "{musica/motor.js,musica/catalogo.json,lib/vendor/**}"
    },
    "api/jornada.js": {
      "includeFiles": "lib/jornada/**"
    }
  },
  "crons": [
    {
      "path": "/api/musica-diario",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/jornada?a=diario",
      "schedule": "0 13 * * *"
    }
  ]
}
